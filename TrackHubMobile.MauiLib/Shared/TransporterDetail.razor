@inject IAppInfo appInfo
@inject ITransporterHelper transporterHelper
@inject TransporterDetailViewModel ViewModel

@if (ViewModel.Transporter is null && ViewModel.IsRefreshing)
{
	<p><em>@LRM["Loading"]...</em></p>
}
else if (ViewModel.HasError && ViewModel.Transporter is null)
{
	<p class="text-muted"><em>@LRM["Error"]</em></p>
} 
else if (ViewModel.Transporter is not null)
{
	<div class="@alertStyle">
        <div class="card-text p-3">
            <h4>@LRM["TransporterDetails"]</h4>
            <ul class="details-list">
                <li><strong>@LRM["Name"]:</strong> @ViewModel.Transporter?.DeviceName</li>
                <li><strong>@LRM["LastReport"]:</strong> @ViewModel.Transporter?.DeviceDateTime.ToLocalTime().ToString("g")</li>
                <li><strong>@LRM["Speed"]:</strong> @ViewModel.Transporter?.Speed km/h</li>
                @if (!string.IsNullOrEmpty(ViewModel.Transporter?.Address))
                {
                    <li><strong>@LRM["Address"]:</strong> @ViewModel.Transporter?.Address</li>
                }
                @if (!string.IsNullOrEmpty(ViewModel.Transporter?.City))
                {
                    <li><strong>@LRM["City"]:</strong> @ViewModel.Transporter?.City</li>
                }
                @if (!string.IsNullOrEmpty(ViewModel.Transporter?.State))
                {
                    <li><strong>@LRM["State"]:</strong> @ViewModel.Transporter?.State</li>
                }
                @if (ViewModel.Transporter?.Attributes is not null)
                {
                    @if (ViewModel.Transporter?.Attributes?.Ignition is not null)
                    {
                        <li><strong>@LRM["AccStatus"]:</strong> @transporterHelper.GetAccStatus(ViewModel.Transporter?.Attributes?.Ignition)</li>
                    }
                    @if (ViewModel.Transporter?.Attributes?.Mileage is not null)
                    {
                        <li><strong>@LRM["Odometer"]:</strong> @ViewModel.Transporter?.Attributes?.Mileage</li>
                    }
                    @if (ViewModel.Transporter?.Attributes?.Temperature is not null)
                    {
                        <li><strong>@LRM["Temperature"]:</strong> @ViewModel.Transporter?.Attributes?.Temperature</li>
                    }
                }
            </ul>
        </div>
	</div>
}