@using TrackHubMobile.Interfaces.Helpers

<div class="top-row ps-3 navbar navbar-dark">
	<div class="container-fluid">
		<a class="navbar-brand" href="">
			<i class="fas fa-satellite-dish me-1"></i> TrackHub
		</a>
		<button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
			<span class="navbar-toggler-icon"></span>
		</button>
	</div>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
	<nav class="flex-column">
		<div class="nav-item px-3">
			<NavLink class="nav-link" href="" Match="NavLinkMatch.All">
				<i class="fas fa-chart-pie nav-icon"></i> @LRM["Home"]
			</NavLink>
		</div>
		<div class="nav-item px-3">
			<NavLink class="nav-link" href="mapview">
				<i class="fas fa-map-marked-alt nav-icon"></i> @LRM["MapView"]
			</NavLink>
		</div>
		<div class="nav-item px-3">
			<NavLink class="nav-link" href="listview">
				<i class="fas fa-list-ul nav-icon"></i> @LRM["ListView"]
			</NavLink>
		</div>
		<div class="nav-item px-3">
			<NavLink class="nav-link" href="about">
				<i class="fas fa-info-circle nav-icon"></i> @LRM["About"]
			</NavLink>
		</div>
		<div class="nav-item px-3">
			<button class="nav-link btn btn-link" @onclick="ViewModel.HandleLogout">
				<i class="fas fa-sign-out-alt nav-icon"></i> @LRM["Logout"]
			</button>
		</div>
	</nav>
</div>
