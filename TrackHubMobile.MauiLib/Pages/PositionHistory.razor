@page "/transporter/{TransporterIdParam}/history"

<div class="history-page">
    <div class="history-topbar">
        <button class="btn btn-sm icon-btn" @onclick="GoBack" title="@LRM["Back"]">
            <i class="fas fa-arrow-left"></i>
        </button>
        <div class="topbar-title">
            <h2>@LRM["PositionHistory"]</h2>
            <span class="range-summary">@RangeSummary</span>
        </div>
        <button class="btn btn-sm icon-btn @(showFilters ? "active" : "")"
                @onclick="ToggleFilters" title="@LRM["Filters"]">
            <i class="fas fa-sliders-h"></i>
        </button>
    </div>

    @if (showFilters)
    {
        <div class="filter-panel">
            <div class="preset-row">
                <button class="chip @(selectedPreset == RangePreset.Last24Hours ? "selected" : "")"
                        @onclick="() => ApplyPresetAsync(RangePreset.Last24Hours)">@LRM["Last24Hours"]</button>
                <button class="chip @(selectedPreset == RangePreset.Today ? "selected" : "")"
                        @onclick="() => ApplyPresetAsync(RangePreset.Today)">@LRM["Today"]</button>
                <button class="chip @(selectedPreset == RangePreset.Yesterday ? "selected" : "")"
                        @onclick="() => ApplyPresetAsync(RangePreset.Yesterday)">@LRM["Yesterday"]</button>
                <button class="chip @(selectedPreset == RangePreset.Day ? "selected" : "")"
                        @onclick="() => ApplyPresetAsync(RangePreset.Day)">@LRM["ChooseDay"]</button>
            </div>

            @if (selectedPreset == RangePreset.Day)
            {
                @* value/@onchange rather than @bind: @bind on a date input converts through
                   DateTime and rewrites the field when the value does not round-trip, which
                   is what made the picker jump back to the previous day. *@
                <div class="day-field">
                    <label class="detail-label" for="history-day">@LRM["ChooseDay"]</label>
                    <input id="history-day" class="form-control form-control-sm" type="date"
                           value="@dayText" max="@MaxDayText" @onchange="OnDayChangedAsync" />
                </div>
            }

            @if (hasStoredHistoryFeature)
            {
                <div class="filter-row">
                    <span class="detail-label">@LRM["HistorySource"]</span>
                    <div class="source-switch">
                        <button class="btn btn-sm @(useStoredSource ? "btn-primary" : "btn-outline-primary")"
                                @onclick="() => SetSourceAsync(true)">
                            @LRM["SourceTrackHub"]
                        </button>
                        <button class="btn btn-sm @(!useStoredSource ? "btn-primary" : "btn-outline-primary")"
                                @onclick="() => SetSourceAsync(false)">
                            @LRM["SourceProvider"]
                        </button>
                    </div>
                </div>
            }

            @if (showRangeError)
            {
                <div class="alert alert-warning history-banner">@LRM["InvalidDay"]</div>
            }
        </div>
    }

    <div class="map-area">
        <div id="map" class="history-map"></div>

        @if (isLoading)
        {
            <div class="map-loading">
                <i class="fas fa-circle-notch fa-2x fa-spin"></i>
                <p>@LRM["Loading"]...</p>
            </div>
        }

        @if (featureDisabled)
        {
            <div class="alert alert-warning history-banner floating-banner">
                <i class="fas fa-lock"></i> @LRM["FeatureDisabledHistory"]
            </div>
        }
        else if (hasError)
        {
            <div class="alert alert-danger history-banner floating-banner">
                <i class="fas fa-exclamation-triangle"></i> @LRM["HistoryError"]
            </div>
        }
        else if (hasSearched && !isLoading)
        {
            <div class="trips-sheet @(sheetExpanded ? "expanded" : "collapsed")">
                <button class="sheet-handle" @onclick="ToggleSheetAsync">
                    <span class="handle-bar"></span>
                    <span class="sheet-summary">
                        @if (trips.Count == 0)
                        {
                            @LRM["NoTripsFound"]
                        }
                        else
                        {
                            <text>@trips.Count @LRM["Trips"]</text>
                        }
                    </span>
                    <i class="fas @(sheetExpanded ? "fa-chevron-down" : "fa-chevron-up")"></i>
                </button>

                @if (trips.Count > 0)
                {
                    <div class="sheet-body">
                        <button class="chip all-chip @(selectedTripId is null ? "selected" : "")"
                                @onclick="DrawAllAsync">
                            <i class="fas fa-layer-group"></i> @LRM["AllTrips"]
                        </button>
                        @foreach (var trip in trips)
                        {
                            var current = trip;
                            var isMoving = IsMoving(current);
                            <div class="trip-card @(current.TripId == selectedTripId ? "selected" : "") @(isMoving ? "moving" : "stopped")"
                                 @onclick="() => SelectTripAsync(current)">
                                <div class="trip-icon">
                                    <i class="fas @(isMoving ? "fa-route" : "fa-parking")"></i>
                                </div>
                                <div class="trip-body">
                                    <div class="trip-title">@(isMoving ? LRM["MovingTrip"] : LRM["StoppedTrip"])</div>
                                    <div class="trip-times">
                                        @current.From.LocalDateTime.ToString("g") - @current.To.LocalDateTime.ToString("g")
                                    </div>
                                    <div class="trip-stats">
                                        @if (isMoving)
                                        {
                                            <span>@LRM["Distance"]: @current.TotalDistance.ToString("N2") km</span>
                                            <span>@LRM["AverageSpeed"]: @current.AverageSpeed.ToString("N1") km/h</span>
                                        }
                                        <span>@LRM["Duration"]: @FormatDuration(current)</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>
